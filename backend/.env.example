# URL de conexão com o PostgreSQL (Supabase). Use o "Session pooler" do
# Supabase (Connect > Direct > Session pooler) se sua rede não tiver IPv6.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Chave secreta usada para assinar os tokens JWT. Gere uma string aleatória
# longa (ex.: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_CHAVE_SECRETA=

# Algoritmo de assinatura do JWT (opcional, padrão HS256)
JWT_ALGORITMO=HS256

# Tempo de expiração do token de acesso, em minutos (opcional, padrão 60)
JWT_EXPIRACAO_MINUTOS=480

# Chat do assistente de IA (Google Gemini). Chave gratuita em
# https://aistudio.google.com (menu "Get API key"). Sem ela, o chat responde
# "não configurado" e o resto do sistema funciona normalmente.
GEMINI_API_KEY=
# Modelo do Gemini (opcional, padrão gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
# Modelos reserva, tentados em ordem se o principal estiver sobrecarregado (opcional)
GEMINI_MODELOS_RESERVA=gemini-2.5-flash,gemini-flash-lite-latest

# Resumo semanal por e-mail (opcional). Sem estes valores, nada é enviado.
# RESEND_API_KEY: chave da API do Resend (https://resend.com).
# RESUMO_REMETENTE: remetente verificado no Resend, ex.: "Argos <resumo@seu-dominio.com>".
# TAREFAS_TOKEN: segredo que o GitHub Actions manda em X-Tarefa-Token (mesmo valor do segredo no GitHub).
RESEND_API_KEY=
RESUMO_REMETENTE=
TAREFAS_TOKEN=
