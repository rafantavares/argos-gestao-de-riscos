# String de conexão do Supabase (Project Settings > Database > Connection string > URI)
# Use a connection pooler (porta 6543) em produção/serverless, ou a porta 5432 direta em dev.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Usado no módulo de autenticação JWT (routes futuras)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
